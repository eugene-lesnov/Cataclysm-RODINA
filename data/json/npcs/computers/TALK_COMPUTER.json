[
  {
    "id": "EOC_REFUGEE_CENTER_COMPUTER",
    "type": "effect_on_condition",
    "effect": [ "open_dialogue" ]
  },
  {
    "type": "talk_topic",
    "id": "COMP_REFUGEE_CENTER_MAIN",
    "dynamic_line": "The computer awaits input…",
    "responses": [
      { "text": "Emergency Message.", "topic": "COMP_EMERGENCY_MESSAGE" },
      {
        "condition": { "u_has_mission": "MISSION_OLD_GUARD_NEC_COMMO_2" },
        "text": "Disable External Power",
        "topic": "COMP_DISABLE_EXTERNAL_POWER"
      },
      { "text": "Contact Us", "topic": "COMP_FIND_REFUGEE_CENTER" },
      { "text": "Log off.", "topic": "TALK_DONE" }
    ]
  },
  {
    "type": "talk_topic",
    "id": "COMP_EMERGENCY_MESSAGE",
    "dynamic_line": "EMERGENCY SERVICE NOTICE.  EVACUATION IS UNDER WAY IN THE DISTRICT.  RESCUE TEAMS ARE WORKING TO REACH THIS SHELTER.\n 1. REMAIN CALM.\n 2. STAY INSIDE WHILE THE BUILDING IS SAFE.\n 3. USE THE BASEMENT IF THE ENTRANCE IS THREATENED.\n 4. KEEP YOUR MASK AND SUPPLIES WITH YOU.\n 5. CHECK THE INFORMATION BOARD FOR THE CAMP ROUTE.",
    "responses": [ { "text": "Press any key.", "topic": "COMP_REFUGEE_CENTER_MAIN" } ]
  },
  {
    "type": "talk_topic",
    "id": "COMP_DISABLE_EXTERNAL_POWER",
    "dynamic_line": "--ACCESS GRANTED--\nMission Complete!",
    "responses": [
      {
        "text": "Press any key.",
        "topic": "COMP_REFUGEE_CENTER_MAIN",
        "effect": { "finish_mission": "MISSION_OLD_GUARD_NEC_COMMO_2", "step": 1 }
      }
    ]
  },
  {
    "type": "talk_topic",
    "id": "COMP_FIND_REFUGEE_CENTER",
    "dynamic_line": "EMERGENCY SERVICE CAMP ROUTE.\n The district evacuation map identifies a camp with medical aid, water, and onward transport.\n Its last update is several days old.  Check the roads before you travel.",
    "responses": [
      {
        "condition": {
          "and": [
            { "math": [ "find_refugee_center != 1" ] },
            { "not": { "u_has_mission": "MISSION_REACH_REFUGEE_CENTER" } },
            { "not": { "compare_string": [ "yes", { "u_val": "found_refugee_center" } ] } }
          ]
        },
        "text": "Make a note of the location.",
        "topic": "COMP_REFUGEE_CENTER_MAIN",
        "effect": [ { "assign_mission": "MISSION_REACH_REFUGEE_CENTER" }, { "math": [ "find_refugee_center = 1" ] } ]
      },
      {
        "condition": {
          "or": [
            { "math": [ "find_refugee_center == 1" ] },
            { "u_has_mission": "MISSION_REACH_REFUGEE_CENTER" },
            { "compare_string": [ "yes", { "u_val": "found_refugee_center" } ] }
          ]
        },
        "text": "Press any key.",
        "topic": "COMP_REFUGEE_CENTER_MAIN"
      }
    ]
  }
]
